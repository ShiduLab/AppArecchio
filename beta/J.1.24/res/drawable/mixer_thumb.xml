<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="20dp" android:height="30dp" android:gravity="center">
        <shape>
            <corners android:radius="4dp" />
            <gradient android:angle="0" android:startColor="#182126"
                android:centerColor="#35434A" android:endColor="#161D21" />
            <stroke android:width="1dp" android:color="#648E98" />
        </shape>
    </item>
    <item android:width="2dp" android:height="18dp" android:gravity="center">
        <shape>
            <solid android:color="#AFE3EC" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
